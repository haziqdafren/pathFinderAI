{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/v1/analysis.ts": { "maxDuration": 30 },
    "api/v1/chat.ts": { "maxDuration": 20 },
    "api/v1/conversation/question.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
